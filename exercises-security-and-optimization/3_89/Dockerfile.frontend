FROM node:16-alpine AS build
WORKDIR /myapp
COPY code/example-frontend .
RUN npm install
ENV REACT_APP_BACKEND_URL=http://localhost:8080
RUN npm run build

FROM node:16-alpine
WORKDIR /myapp
COPY --from=build /myapp/build ./build
RUN npm install -g serve
USER node
EXPOSE 5000
CMD ["serve", "-s", "-l", "5000", "build"]
