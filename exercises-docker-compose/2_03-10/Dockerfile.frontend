FROM ubuntu:22.04
RUN sed -i 's#//[a-z]*\.ubuntu\.com#//mirrors.edge.kernel.org#g' $(ls /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null)
RUN apt-get update && apt-get install -y curl xz-utils ca-certificates && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://nodejs.org/dist/v16.20.2/node-v16.20.2-linux-x64.tar.xz | tar -xJ -C /usr/local --strip-components=1
WORKDIR /usr/src/app
COPY frontend .
RUN npm install
# unset: the frontend falls back to the relative /api path, served by nginx
RUN npm run build
RUN npm install -g serve
EXPOSE 5000
CMD ["serve", "-s", "-l", "5000", "build"]
